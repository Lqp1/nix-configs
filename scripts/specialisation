#!/usr/bin/env bash
set -euo pipefail

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
  TITLE="$(tput bold)$(tput setaf 4)"
  GOOD="$(tput setaf 2)"
  WARN="$(tput setaf 3)"
  RESET="$(tput sgr0)"
else
  TITLE="" GOOD="" WARN="" RESET=""
fi

section() {
  printf "\n%s== %s ==%s\n" "$TITLE" "$1" "$RESET"
}

get_priv_cmd() {
  if command -v run0 >/dev/null 2>&1; then
    echo "run0"
  elif command -v sudo >/dev/null 2>&1; then
    echo "sudo"
  else
    echo ""
  fi
}

get_base_system() {
  if [[ -L /nix/var/nix/profiles/system ]]; then
    readlink -f /nix/var/nix/profiles/system
  elif [[ -d /run/booted-system ]]; then
    readlink -f /run/booted-system
  else
    readlink -f /run/current-system
  fi
}

current_specialisation() {
  if [[ -f /etc/specialisation ]]; then
    local spec
    spec="$(head -n1 /etc/specialisation 2>/dev/null | xargs)"
    if [[ -n "$spec" && "$spec" != "default" ]]; then
      echo "$spec"
      return
    fi
  fi
  echo "default"
}

BASE_SYSTEM="$(get_base_system)"
CURRENT="$(current_specialisation)"
TARGET="${1:-toggle}"
ACTION="${2:-test}" # 'test' switches live without touching bootloader; 'switch' also updates boot default

case "$TARGET" in
  status)
    section "Current Specialisation"
    echo "Active: ${GOOD}${CURRENT}${RESET}"
    if [[ -d "$BASE_SYSTEM/specialisation" ]]; then
      echo "Available specialisations in generation ($(basename "$BASE_SYSTEM")):"
      for s in "$BASE_SYSTEM"/specialisation/*; do
        [[ -d "$s" ]] && echo "  - $(basename "$s")"
      done
    fi
    exit 0
    ;;
  toggle)
    if [[ "$CURRENT" =~ ^[Pp]owersave ]]; then
      TARGET="default"
    else
      TARGET="Powersave"
    fi
    ;;
  powersave|Powersave)
    TARGET="Powersave"
    ;;
  default|main)
    TARGET="default"
    ;;
esac

PRIV="$(get_priv_cmd)"
if [[ -z "$PRIV" && $EUID -ne 0 ]]; then
  echo "${WARN}Error: Root privileges required (run0 or sudo).${RESET}" >&2
  exit 1
fi

section "Switching Specialisation"
echo "Current System : ${WARN}${CURRENT}${RESET}"
echo "Target Profile : ${GOOD}${TARGET}${RESET}"
echo "Base Generation: $BASE_SYSTEM"

if [[ "$TARGET" == "default" ]]; then
  SCRIPT="$BASE_SYSTEM/bin/switch-to-configuration"
  if [[ ! -x "$SCRIPT" ]]; then
    echo "${WARN}Error: Default activation script not found: $SCRIPT${RESET}" >&2
    exit 1
  fi
  echo "Activating base default profile..."
  $PRIV "$SCRIPT" "$ACTION"
else
  SCRIPT="$BASE_SYSTEM/specialisation/$TARGET/bin/switch-to-configuration"
  if [[ ! -x "$SCRIPT" ]]; then
    echo "${WARN}Error: Specialisation '$TARGET' not found in $BASE_SYSTEM/specialisation/${RESET}" >&2
    exit 1
  fi
  echo "Activating specialisation '$TARGET'..."
  $PRIV "$SCRIPT" "$ACTION"
fi

section "Done"
echo "${GOOD}Successfully switched to ${TARGET}!${RESET}"
